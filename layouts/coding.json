{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "folder-spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work-stack",
      "type": "stack",
      "active": "work",
      "children": [
        {
          "id": "work",
          "type": "column",
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "coding-tabs"
              },
              "size": {
                "px": 42
              },
              "window_drag": true
            },
            {
              "id": "work-body",
              "type": "row",
              "children": [
                {
                  "id": "panel",
                  "type": "column",
                  "children": [
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "children": [
                        {
                          "id": "changes",
                          "type": "block",
                          "content": {
                            "mod": "coding-changes"
                          }
                        },
                        {
                          "id": "files",
                          "type": "block",
                          "content": {
                            "mod": "coding-files"
                          }
                        }
                      ],
                      "active": "changes"
                    }
                  ],
                  "size": {
                    "px": 320
                  },
                  "min": 220,
                  "max": 700
                },
                {
                  "id": "code",
                  "type": "column",
                  "children": [
                    {
                      "id": "editor",
                      "type": "block",
                      "content": {
                        "mod": "editor",
                        "props": {
                          "follow": true
                        }
                      },
                      "size": {
                        "weight": 3
                      },
                      "min": 120,
                      "hidden": true
                    },
                    {
                      "id": "main",
                      "type": "block",
                      "content": {
                        "tab": "active",
                        "pane": {
                          "header": {
                            "content": {
                              "mod": "pane"
                            },
                            "reveal": "always",
                            "height": 30,
                            "position": "top"
                          },
                          "background": "background",
                          "border": {
                            "width": 1,
                            "color": "border"
                          },
                          "focus": {
                            "width": 1,
                            "color": "accent"
                          },
                          "radius": 10,
                          "gap": 8,
                          "lone": true
                        }
                      },
                      "size": {
                        "weight": 2
                      },
                      "min": 80
                    }
                  ],
                  "gap": 8
                }
              ],
              "padding": 8,
              "gap": 8
            },
            {
              "id": "status-row",
              "type": "row",
              "children": [
                {
                  "id": "status",
                  "type": "block",
                  "content": {
                    "mod": "workspace-status"
                  },
                  "size": {
                    "weight": 1
                  }
                },
                {
                  "id": "space-layout",
                  "type": "block",
                  "content": {
                    "mod": "space-layouts"
                  },
                  "size": {
                    "px": 230
                  }
                },
                {
                  "id": "island",
                  "type": "block",
                  "size": {
                    "px": 78
                  },
                  "content": {
                    "mod": "island"
                  }
                },
                {
                  "id": "agent-alerts",
                  "type": "block",
                  "content": {
                    "mod": "agent-alerts"
                  },
                  "size": {
                    "px": 96
                  }
                }
              ],
              "size": {
                "px": 28
              },
              "resizable": false
            }
          ],
          "resizable": false
        },
        {
          "id": "overview",
          "type": "block",
          "padding": 12,
          "content": {
            "mod": "folder-overview"
          }
        }
      ]
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "preview": "layouts/coding.svg"
}